{
  "schemaVersion": 1,
  "id": "zenan-addon",
  "version": "${version}",
  "name": "Zenan Addon",
  "description": "Flags suspicious chunks.",
  "authors": [
    "jake"
  ],
  "contact": {
    "sources": "https://github.com/jakeTheCode/zenan-addon-v2"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.basehunter.addon.BaseHunterAddon"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
